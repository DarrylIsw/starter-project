PORT=3001
HOST=

# Use either DATABASE_URL or the PG* variables below.
DATABASE_URL=
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Observability
SERVICE_NAME=ris-web

# Optional email delivery. It remains completely inactive until explicitly enabled
# and every required value is valid.
EMAIL_ENABLED=false
APP_BASE_URL=http://localhost:3001
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_BRAND_NAME=Research Information System
EMAIL_SUPPORT_ADDRESS=

# SMTP provider
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Delivery safety. In development/test, set at least one of these before enabling.
# Redirect sends every message to one safe inbox. Allowlist accepts comma-separated emails.
EMAIL_REDIRECT_ALL_TO=
EMAIL_RECIPIENT_ALLOWLIST=

# Optional worker tuning
EMAIL_WORKER_POLL_MS=30000
EMAIL_WORKER_BATCH_SIZE=25
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_MS=60000
EMAIL_STALE_LOCK_MINUTES=15
